# Gruvbox Dark
background-color=#282828
text-color=#ebdbb2
border-color=#d79921
progress-color=over #504945

# Geometry
width=360
height=120
margin=12
padding=12
border-size=2
border-radius=10

# Text
font=JetBrainsMono Nerd Font 14

# Behaviour
default-timeout=5000
ignore-timeout=1

# Icons
icons=1
max-icon-size=48

# Position
anchor=top-right

# Group notifications from the same app
group-by=app-name

[urgency=low]
border-color=#928374
default-timeout=3000

[urgency=normal]
border-color=#d79921

[urgency=high]
border-color=#cc241d
text-color=#fbf1c7
default-timeout=0
