{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": "full",

  "modules": [
    {
      "type": "os",
      "keyColor": "red"
    },
    {
      "type": "host",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "keyColor": "blue"
    },
    {
      "type": "cpu",
      "keyColor": "magenta"
    },
    {
      "type": "gpu",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "keyColor": "yellow"
    },

    "break"
  ]
}
