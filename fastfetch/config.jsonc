{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo8.txt" //favorite: default (logo.txt), 2, 8, 18,  ,24
  },

  "modules": [
    {
      "type": "os",
      "keyColor": "red"
    },
    {
      "type": "host",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "keyColor": "blue"
    },
    {
      "type": "cpu",
      "keyColor": "magenta"
    },
    {
      "type": "gpu",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "keyColor": "yellow"
    },

    "break"
  ]
}
