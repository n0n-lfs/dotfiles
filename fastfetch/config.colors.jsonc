},
{
  "type": "kernel",
  "keyColor": "red"
},
{
  "type": "uptime",
  "keyColor": "green"
},
{
  "type": "wm",
  "keyColor": "magenta"
},
{
  "type": "cpu",
  "keyColor": "yellow"
},
{
  "type": "gpu",
  "keyColor": "blue"
},
{
  "type": "memory",
  "keyColor": "cyan"
}
]
}
